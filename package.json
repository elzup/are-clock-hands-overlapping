{
  "name": "are-clock-hands-overlapping",
  "version": "0.0.0",
  "description": "Judge whether the hour and minute hands of an analog clock overlap",
  "author": "elzup",
  "license": "MIT",
  "type": "module",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "types": "lib/types/index.d.ts",
  "bin": {
    "are-clock-hands-overlapping": "lib/esm/cli/bin.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elzup/are-clock-hands-overlapping.git"
  },
  "bugs": {
    "url": "https://github.com/elzup/are-clock-hands-overlapping/issues"
  },
  "homepage": "https://github.com/elzup/are-clock-hands-overlapping#readme",
  "keywords": [
    "clock",
    "analog-clock",
    "clock-hands",
    "overlap",
    "time",
    "temporal",
    "cli"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "clean": "rimraf lib",
    "build": "npm run clean && npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "tsc --module commonjs --outDir lib/cjs && echo '{\"type\": \"commonjs\"}' > lib/cjs/package.json",
    "build:esm": "tsc --module esnext --outDir lib/esm --moduleResolution node --allowSyntheticDefaultImports",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir lib/types",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:cov": "vitest run --coverage",
    "prepublishOnly": "npm run build && npm test"
  },
  "sideEffects": false,
  "devDependencies": {
    "@biomejs/biome": "^2.4.10",
    "@elzup/tsconfig": "1.1.0",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "^4.0.15",
    "@vitest/ui": "^4.0.15",
    "rimraf": "^6.1.2",
    "typescript": "5.9.3",
    "vitest": "^4.0.15"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib/"
  ],
  "packageManager": "pnpm@12.15.0"
}
